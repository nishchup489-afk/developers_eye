# Server-only origin of the FastAPI backend; /api/search forwards to BACKEND_URL/search.
# Comment it out to use the labeled local demo fixtures instead. Restart Next.js after changing it.
BACKEND_URL=http://127.0.0.1:8000

# AI overview is configured in backend/.env; this frontend only displays it.

# Admin: register a GitHub OAuth App with this exact callback:
# http://localhost:3000/api/auth/github/callback
ADMIN_APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user IDs (not usernames). Empty = deny all.
ADMIN_GITHUB_IDS=
# Read-only dashboard access (admins keep full access):
#   off    = only ADMIN_GITHUB_IDS and ADMIN_VIEWER_GITHUB_IDS (default)
#   github = any signed-in GitHub account is a read-only viewer
#   public = anyone can view without signing in
ADMIN_VIEWER_ACCESS=off
# Comma-separated numeric GitHub user IDs that get read-only access.
ADMIN_VIEWER_GITHUB_IDS=
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Server-only bridge to the FastAPI endpoint. Use the same key in backend/.env.
CRAWLER_REPORT_API_URL=http://127.0.0.1:8000/admin/crawler/report
CRAWLER_REPORT_API_KEY=
