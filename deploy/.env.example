# Copy to deploy/.env and fill in. Never commit the copy.
SITE_ADDRESS=api.example.com
# Existing directory ON the mounted block volume; preflight.sh verifies the mount.
PGDATA_HOST_PATH=/data/pgdata
# Leave these unset on a 4 OCPU / 24 GB VM. On 2 OCPU / 12 GB use:
# POSTGRES_CONFIG=postgresql-12gb.conf
# POSTGRES_SHM_SIZE=3gb
POSTGRES_PASSWORD=
# Generate each secret with: openssl rand -hex 32
CRAWLER_REPORT_API_KEY=
EDGE_SHARED_SECRET=
# Corpus budget. cap-sources.sh scales every source's max_pages to fit it; this is
# the only hard document limit. The two ADMIN_ values only drive dashboard progress
# and warnings, so keep them in line with it.
CRAWL_MAX_DOCUMENTS=150000
ADMIN_TARGET_DOCUMENTS=150000
ADMIN_DB_BUDGET_GB=20
# disk-guard.sh stops the crawler when any of these is crossed.
CRAWL_MIN_FREE_GB=20
CRAWL_MIN_ROOT_FREE_GB=5
CRAWL_MAX_DB_GB=25
# Must match the crawler's --min-interval-seconds.
ADMIN_HOST_MIN_INTERVAL_SECONDS=2
# Public search limits. Defaults shown. Each uvicorn worker keeps its own rate-limit buckets.
# SEARCH_RATE_LIMIT_PER_MINUTE=60
# SEARCH_RATE_LIMIT_BURST=20
# SEARCH_MAX_CONCURRENT=16
# SEARCH_QUERY_DEADLINE_MS=3000
# SEARCH_TOTAL_DEADLINE_MS=4000
# Offsite copy target for backup.sh, for example an rclone remote. Empty keeps backups local.
BACKUP_REMOTE=
BACKUP_DIR=/data/backups
BACKUP_KEEP_DAYS=7
# Optional FastAPI-owned Groq AI overview (see backend/README.md).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_OVERVIEW=true
# Identity is assigned by authenticated edge middleware, not a raw header setting.
AI_OVERVIEW_CLIENT_IP_HEADER=
