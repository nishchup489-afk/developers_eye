# Copy to deploy/.env and fill in. Never commit the copy.
SITE_ADDRESS=search.example.com
POSTGRES_PASSWORD=
# Generate each secret with: openssl rand -hex 32
CRAWLER_REPORT_API_KEY=
ADMIN_SESSION_SECRET=
ADMIN_APP_URL=https://search.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_IDS=
ADMIN_TARGET_DOCUMENTS=2000000
ADMIN_DB_BUDGET_GB=120
# Must match the crawler's --min-interval-seconds.
ADMIN_HOST_MIN_INTERVAL_SECONDS=2
# Public search limits. Defaults shown. Each uvicorn worker keeps its own rate-limit buckets.
# SEARCH_RATE_LIMIT_PER_MINUTE=60
# SEARCH_RATE_LIMIT_BURST=20
# SEARCH_MAX_CONCURRENT=16
# SEARCH_QUERY_DEADLINE_MS=3000
# SEARCH_TOTAL_DEADLINE_MS=4000
# Offsite copy target for backup.sh, for example an rclone remote. Empty keeps backups local.
BACKUP_REMOTE=
