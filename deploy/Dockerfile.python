# Backend API, crawler, indexer and maintenance all run from this one image.
# Build from the repository root: docker build -f deploy/Dockerfile.python .
FROM python:3.14-slim AS build
ENV PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends gcc libxml2-dev libxslt1-dev libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/pyproject.toml backend/README.md backend/
COPY backend/src backend/src
COPY crawler/pyproject.toml crawler/
COPY crawler/src crawler/src
RUN python -m venv /venv && /venv/bin/pip install ./backend ./crawler

FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends libxml2 libxslt1.1 \
    && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 10001 app
COPY --from=build /venv /venv
COPY backend/alembic /app/backend/alembic
COPY backend/alembic.ini /app/backend/alembic.ini
ENV PATH=/venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app/backend
USER app
