# Developer's Eye production reference (live since 2026-11-13).
# This file holds every setting, URL and location the live site uses. It contains
# NO secrets: each secret says where its real value lives. Never commit real values.
# The real files are /opt/developers-eye/deploy/.env on the VM and Vercel's settings.

# =============================================================================
# Public endpoints
# =============================================================================
# API (Caddy -> FastAPI), TLS by Let's Encrypt. sslip.io maps the name to the IP.
#   https://132-145-194-228.sslip.io/health     public liveness, returns {"status":"ok"}
#   https://132-145-194-228.sslip.io/search     403 unless the request has X-Edge-Secret
# Frontend: your Vercel production URL (Vercel > project > Domains).
# SSH:      ssh -i ~/.ssh/oracle-de.key ubuntu@132.145.194.228
#           (key file on the PC: C:\Users\nishc\.ssh\oracle-de.key; keep a backup)

# =============================================================================
# Oracle Cloud (region us-ashburn-1, root compartment)
# =============================================================================
# Instance:      developers-eye, VM.Standard.A1.Flex, 4 OCPU / 24 GB, Ubuntu 24.04 aarch64, AD-2
# Public IP:     132.145.194.228 (reserved; stays if the VM stops)
# Private IP:    10.0.0.66
# Network:       vcn-20260818-1515 / subnet-20260818-1515, Default Security List
#                ingress: 22 (default), 80 and 443 from 0.0.0.0/0
# Host firewall: iptables ACCEPT 80/443, saved with netfilter-persistent
# Boot volume:   50 GB  (/, Docker images and logs)
# Block volume:  developers_eye_data, 150 GB, AD-2, paravirtualized -> /dev/sdb -> /data (fstab by UUID)
# Swap:          /swapfile 4 GB
# Free-tier limit: 4 OCPU, 24 GB RAM, 200 GB block storage in total. Do not add more.

# =============================================================================
# Paths on the VM
# =============================================================================
# /opt/developers-eye         git checkout of main
# /opt/developers-eye/deploy  run every docker compose command from here
# /data/pgdata                PostgreSQL 18 data, owned by uid 70 (postgres in the container)
# /data/backups               nightly backup.sh dumps, kept BACKUP_KEEP_DAYS days
# /data/upload                scp drop folder (owned by ubuntu)

# =============================================================================
# VM: /opt/developers-eye/deploy/.env   (chmod 600, never committed)
# =============================================================================
SITE_ADDRESS=132-145-194-228.sslip.io
PGDATA_HOST_PATH=/data/pgdata
# 4 OCPU / 24 GB VM: leave these two unset (postgresql.conf, 6 GB shm).
# POSTGRES_CONFIG=postgresql-12gb.conf
# POSTGRES_SHM_SIZE=3gb

# Secrets: 64 hex characters each, made with `openssl rand -hex 32`. Read them with
#   grep -E '^(POSTGRES_PASSWORD|EDGE_SHARED_SECRET|CRAWLER_REPORT_API_KEY)=' /opt/developers-eye/deploy/.env
POSTGRES_PASSWORD=<secret: VM .env only>
EDGE_SHARED_SECRET=<secret: VM .env AND Vercel, identical>
CRAWLER_REPORT_API_KEY=<secret: VM .env AND Vercel (only if admin is enabled), identical>

# Corpus budget. cap-sources.sh scaled source max_pages to fit it on 2026-11-13.
CRAWL_MAX_DOCUMENTS=150000
ADMIN_TARGET_DOCUMENTS=150000
ADMIN_DB_BUDGET_GB=20
# disk-guard.sh stops the crawler when any limit is crossed.
CRAWL_MIN_FREE_GB=20
CRAWL_MIN_ROOT_FREE_GB=5
CRAWL_MAX_DB_GB=25
ADMIN_HOST_MIN_INTERVAL_SECONDS=2

BACKUP_REMOTE=
BACKUP_DIR=/data/backups
BACKUP_KEEP_DAYS=7

GROQ_API_KEY=<secret: VM .env only, from console.groq.com>
GROQ_MODEL=qwen/qwen3.8-27b
AI_OVERVIEW=true
AI_OVERVIEW_CLIENT_IP_HEADER=

# =============================================================================
# Vercel: project > Settings > Environment Variables (Production)
# Root Directory: frontend. Node 24. Region iad1 (frontend/vercel.json).
# Redeploy after any change. Never prefix any of these with NEXT_PUBLIC_.
# =============================================================================
# Required for search:
#   BACKEND_URL=https://132-145-194-228.sslip.io
#   EDGE_SHARED_SECRET=<same value as on the VM>
# Optional SEO origin (canonical URLs, sitemap, share images). Defaults to the
# Vercel production domain; set it only after adding a custom domain:
#   SITE_URL=https://<your-domain>
# Optional knowledge panel:
#   KNOWLEDGE_PANEL=on
#   WIKIPEDIA_USER_AGENT=<real contact, e.g. "DevelopersEye/1.0 (you@example.com)">
# Optional /admin dashboard (GitHub OAuth App callback:
#   https://<vercel-domain>/api/auth/github/callback):
#   ADMIN_APP_URL=https://<vercel-domain>
#   GITHUB_CLIENT_ID=<from the GitHub OAuth App>
#   GITHUB_CLIENT_SECRET=<secret: from the GitHub OAuth App>
#   ADMIN_GITHUB_IDS=240237589
#   ADMIN_SESSION_SECRET=<secret: new `openssl rand -hex 32`, Vercel only>
#   CRAWLER_REPORT_API_URL=https://132-145-194-228.sslip.io/admin/crawler/report
#   CRAWLER_REPORT_API_KEY=<same value as on the VM>
#   ADMIN_VIEWER_ACCESS=off
