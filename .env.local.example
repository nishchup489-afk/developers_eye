# Copy this file to .env.local (same folder) and fill it in.
# .env.local is git-ignored. Both pytest projects and scripts/run_all_tests.py
# read it automatically, so you never export these in the terminal again.
#
# Only test settings are read from it: keys starting with TEST_ or containing
# _TEST_. A value already set in the shell wins over this file.

# Dedicated PostgreSQL test database. Its name must contain "test";
# the tests create and drop tables in it.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/developers_eye_test

# Optional: let the AI overview integration tests use the local configured DB.
# OVERVIEW_TEST_USE_LOCAL_DB=1
