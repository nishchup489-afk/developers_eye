DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/developers_eye
# Generate a random 32+ character secret, matching frontend/.env.local.
CRAWLER_REPORT_API_KEY=

# Optional backend-owned Groq overview. Apply Alembic migrations before enabling.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_OVERVIEW=true
# Empty = use the connecting client's IP. Set only behind a trusted ingress.
# Compose's Caddy overwrites X-Eye-Client-IP and the Next proxy preserves it.
AI_OVERVIEW_CLIENT_IP_HEADER=


# Admin capacity planning (System page and problem checks).
ADMIN_DB_BUDGET_GB=120
ADMIN_TARGET_DOCUMENTS=5000000
# Must match the crawler's per-host gap (DEFAULT_MIN_INTERVAL_SECONDS).
ADMIN_HOST_MIN_INTERVAL_SECONDS=2
# crawl_event rows older than this are removed by: python -m backend.admin_services.maintenance --purge-events
ADMIN_EVENT_RETENTION_DAYS=14
# Optional: alerts job target, e.g. https://ntfy.sh/<private-topic>
# ADMIN_ALERT_URL=
